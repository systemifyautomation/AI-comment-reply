    {"parameters":{"jsCode":"const request = $('Hash submitted verification code').item.json;\nconst stored = $json;\nconst verified = Boolean(stored.code_hash && stored.expires_at && Number(stored.attempts || 0) < 5 && new Date(stored.expires_at) > new Date() && request.code_hash === stored.code_hash);\nreturn [{ json: { email: request.email, attempts: Number(stored.attempts || 0) + 1, verified } }];"},"id":"9","name":"Check verification code","type":"n8n-nodes-base.code","typeVersion":2,"position":[1140,440]},
