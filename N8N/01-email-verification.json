    {"parameters":{"httpMethod":"POST","path":"replyflow-email-verification","responseMode":"responseNode","options":{}},"id":"1","name":"Email verification webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,300]},
    {"parameters":{"jsCode":"const { email, action, code } = $json.body ?? {};\nconst normalizedEmail = String(email ?? '').trim().toLowerCase();\nconst submittedCode = String(code ?? '').trim();\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(normalizedEmail)) throw new Error('A valid email address is required.');\nif (!['request_code', 'verify_code'].includes(action)) throw new Error('Unsupported verification action.');\nif (action === 'verify_code' && !submittedCode) throw new Error('A verification code is required.');\nreturn [{ json: { email: normalizedEmail, action, code: submittedCode } }];"},"id":"2","name":"Validate and prepare request","type":"n8n-nodes-base.code","typeVersion":2,"position":[220,300]},
