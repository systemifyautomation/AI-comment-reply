    {"parameters":{"fromEmail":"={{ $env.REPLYFLOW_FROM_EMAIL }}","toEmail":"={{ $('Validate and prepare request').item.json.email }}","subject":"Your ReplyFlow verification code","emailType":"text","message":"=Your ReplyFlow verification code is {{ $('Validate and prepare request').item.json.generatedCode }}. It expires in 10 minutes. If you did not request this, you can ignore this email.","options":{}},"id":"6","name":"Send verification email","type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1130,170],"credentials":{"smtp":{"id":"REPLACE_WITH_BREVO_SMTP_CREDENTIAL_ID","name":"Brevo SMTP"}}},
