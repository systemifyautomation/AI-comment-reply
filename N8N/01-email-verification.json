    {"parameters":{"jsCode":"const request = $('Validate and prepare request').item.json;\nconst stored = $json;\nlet verified = false;\nif (stored.code_hash && stored.expires_at && Number(stored.attempts || 0) < 5 && new Date(stored.expires_at) > new Date()) {\n  const hash = Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(request.code)))).map(b => b.toString(16).padStart(2, '0')).join('');\n  verified = hash === stored.code_hash;\n}\nreturn [{ json: { email: request.email, attempts: Number(stored.attempts || 0) + 1, verified } }];"},"id":"9","name":"Check verification code","type":"n8n-nodes-base.code","typeVersion":2,"position":[910,440]},
