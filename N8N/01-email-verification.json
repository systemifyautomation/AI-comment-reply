  "nodes": [
    {"parameters":{"httpMethod":"POST","path":"replyflow-email-verification","responseMode":"responseNode","options":{}},"id":"1","name":"Email verification webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,300]},
    {"parameters":{"jsCode":"const { email, action, code } = $json.body ?? {};\nconst normalizedEmail = String(email ?? '').trim().toLowerCase();\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(normalizedEmail)) throw new Error('A valid email address is required.');\nif (!['request_code', 'verify_code'].includes(action)) throw new Error('Unsupported verification action.');\nconst result = { email: normalizedEmail, action, code: String(code ?? '').trim() };\nif (action === 'request_code') {\n  const random = new Uint32Array(1);\n  crypto.getRandomValues(random);\n  const value = String(100000 + (random[0] % 900000));\n  const hash = Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(value)))).map(b => b.toString(16).padStart(2, '0')).join('');\n  Object.assign(result, { generatedCode: value, code_hash: hash, expires_at: new Date(Date.now() + 10 * 60 * 1000).toISOString(), attempts: 0, last_sent_at: new Date().toISOString() });\n} else if (!result.code) throw new Error('A verification code is required.');\nreturn [{ json: result }];"},"id":"2","name":"Validate and prepare request","type":"n8n-nodes-base.code","typeVersion":2,"position":[220,300]},
