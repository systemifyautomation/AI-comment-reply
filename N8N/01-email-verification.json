    {"parameters":{"jsCode":"const entropy = String($json.verification_entropy ?? '');\nconst value = String(100000 + (parseInt(entropy.slice(0, 8), 16) % 900000));\nif (!/^\\d{6}$/.test(value)) throw new Error('Could not generate a verification code.');\nreturn [{ json: { ...$json, generatedCode: value, codeToHash: value, expires_at: new Date(Date.now() + 10 * 60 * 1000).toISOString(), attempts: 0, last_sent_at: new Date().toISOString() } }];"},"id":"16","name":"Prepare verification code","type":"n8n-nodes-base.code","typeVersion":2,"position":[680,170]},
