{
  "manifest_version": 3,
  "name": "ReplyFlow - Social AI Replies",
  "version": "2.1.0",
  "description": "Draft contextual replies across supported social platforms with n8n.",
  "permissions": [
    "storage"
  ],
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.n8n.cloud/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.facebook.com/*",
        "https://*.facebook.com/*",
        "https://www.instagram.com/*",
        "https://www.reddit.com/*",
        "https://*.reddit.com/*",
        "https://open.spotify.com/*",
        "https://rumble.com/*",
        "https://*.rumble.com/*",
        "https://www.linkedin.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "page-context.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReplyFlow",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
