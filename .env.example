# Keep the real .env on the relay server only. Do not put it in the extension package.
REPLYFLOW_WEBHOOK_URL=https://your-n8n-host/webhook/your-secret-webhook-path
REPLYFLOW_AUTH_WEBHOOK_URL=https://your-n8n-host/webhook/replyflow-email-verification
PORT=3000
# Comma-separated allowed browser origins, e.g. chrome-extension://your-extension-id
ALLOWED_ORIGINS=
